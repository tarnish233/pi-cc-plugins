{
	"name": "pi-cc-plugins",
	"version": "0.6.2",
	"description": "Prompt keys for the Pi coding agent: Up brings back a queued message or cleared draft, and a one-line summary closes every run. Enter keeps Pi's own keys.",
	"author": "tarnish233",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"extension",
		"claude-code",
		"prompt",
		"keybindings",
		"queue",
		"history",
		"summary"
	],
	"homepage": "https://github.com/tarnish233/pi-cc-plugins#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tarnish233/pi-cc-plugins.git"
	},
	"bugs": {
		"url": "https://github.com/tarnish233/pi-cc-plugins/issues"
	},
	"files": [
		"*.ts",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@types/node": "^22.19.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs",
		"typecheck": "node scripts/typecheck.mjs"
	},
	"publishConfig": {
		"access": "public"
	}
}
